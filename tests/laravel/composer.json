{
    "name": "neon-local/laravel-tests",
    "description": "Laravel ORM tests for Neon Local container",
    "type": "project",
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "illuminate/container": "^10.0",
        "illuminate/pagination": "^10.0",
        "illuminate/validation": "^10.0",
        "doctrine/dbal": "^3.6",
        "nesbot/carbon": "^2.68"
    },
    "autoload": {
        "psr-4": {
            "LaravelTests\\": "src/",
            "LaravelTests\\Models\\": "src/Models/",
            "LaravelTests\\Migrations\\": "database/migrations/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
